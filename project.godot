[application]

config/name="Rootkit: Zero"
run/main_scene="res://HomeScreen.tscn"
boot_splash/image="res://assets/boot_splash.png"
boot_splash/bg_color=Color( 0.0156863, 0, 0, 1 )
config/icon="res://icon.png"
boot_splash/minimum_display_time=2

[autoload]

GameManager="*res://GameManager.gd"
DiscordIpc="*res://scripts/discord_ipc.gd"
Discord="*res://addons/discord_game_sdk/discord.gd"

[discord_presence]

first_button/label="Rootkit: Zero"
first_button/url=""
settings/change_time_per_screen=false

[display]

window/size/width=1920
window/size/height=1080
window/size/test_width=1240
window/size/test_height=700
window/stretch/mode="2d"
window/stretch/aspect="keep"

[editor_plugins]

enabled=PoolStringArray( "res://addons/discord_game_sdk/plugin.cfg" )

[gui]

common/drop_mouse_on_gui_input_disabled=true

[mono]

project/assembly_name="Rootkit Zero"

[physics]

common/enable_pause_aware_picking=true

[rendering]

quality/filters/use_nearest_mipmap_filter=true
environment/default_clear_color=Color( 0, 0, 0, 1 )
environment/default_environment="res://default_env.tres"
